# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by default — never commit real credentials.

# Gmail SMTP (requires 2-Step Verification + an App Password on the sending account)
# Generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cosecentai@gmail.com
SMTP_PASS=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=cosecentai@gmail.com
